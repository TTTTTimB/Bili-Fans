# 复制为 bilifans.toml 后生效。所有字段都有默认值，只写你要改的即可。
db = "bilifans.db"
timezone = "Asia/Shanghai"

[request]
timeout = 15          # 单次请求超时（秒）
retries = 3           # 失败重试次数（412 / 429 / 5xx 会退避重试）
interval_minutes = 5  # daemon 模式的采样间隔，5 分钟足够，不要更密

[creator]
# 创作中心「涨粉 / 掉粉」接口，只给这一个 URL 即可，一次拉回近 30 天。
url = "https://member.bilibili.com/x/web/index/stat"
# Cookie 不写进文件更安全，这里只指定环境变量名。
cookie_env = "BILI_COOKIE"

[report]
default_days = 30
